{
  "name": "secure-express-api",
  "version": "1.0.0",
  "description": "Node.js Express API with full security pipeline",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint 'src/**/*.ts' --max-warnings=0",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "secretlint": "secretlint '**/*'",
    "audit:check": "audit-ci --high",
    "prepare": "node node_modules/husky/bin.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.3.1",
    "zod": "^3.23.8",
    "dotenv-safe": "^8.2.0",
    "winston": "^3.13.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/morgan": "^1.9.9",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-n": "^17.9.0",
    "husky": "^9.1.1",
    "lint-staged": "^15.2.7",
    "secretlint": "^8.3.0",
    "@secretlint/secretlint-rule-preset-recommend": "^8.3.0",
    "audit-ci": "^6.6.1",
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --max-warnings=0"
    ],
    "*": [
      "secretlint"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
